# Copy to .env and fill in. Get a FREE key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Free-tier model that reads PDFs. Alternatives: gemini-2.5-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash

# SQLite locally; set to your Postgres URL in production (e.g. from Neon/Supabase/Render).
DATABASE_URL=sqlite:///./doclens.db

# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

MAX_UPLOAD_MB=25
