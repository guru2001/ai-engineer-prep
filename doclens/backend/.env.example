# Copy to .env and fill in. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Cheap model that supports structured outputs. Alternatives: gpt-4.1-mini, gpt-4o
OPENAI_MODEL=gpt-4o-mini

# SQLite locally; set to your Postgres URL in production (e.g. from Neon/Supabase/Render).
DATABASE_URL=sqlite:///./doclens.db

# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

MAX_UPLOAD_MB=25
